import subprocess
from pathlib import Path
from threading import Lock


class AudioEngine:
    """
    PCM5122 bowl audio backend.

    This backend intentionally delegates waveform generation to the
    existing known-good tools/smooth_bowl_drive.py script.

    Flask/controller code remains hardware-agnostic and only configures:
      - device
      - channel
      - frequency
      - amplitude
      - envelope
    """

    SUPPORTED_WAVEFORMS = {
        "sine",
    }

    def __init__(
        self,
        device="hw:3,1",
        channel="both",
    ):
        self._lock = Lock()

        self.device = str(device)
        self.channel = str(channel).lower()

        self.running = False
        self.waveform = "sine"

        self.frequency_hz = 528.7
        self.amplitude = 0.5

        self.attack_s = 3.0
        self.hold_s = 4.0
        self.release_s = 5.0
        self.rest_s = 3.0
        self.repeats = 1

        self._process = None

        root = Path(__file__).resolve().parents[2]

        self.driver_script = (
            root /
            "tools" /
            "smooth_bowl_drive.py"
        )

    def configure(
        self,
        frequency_hz=None,
        amplitude=None,
        waveform=None,
        attack_s=None,
        hold_s=None,
        release_s=None,
        rest_s=None,
        repeats=None,
        device=None,
        channel=None,
    ):
        with self._lock:

            if frequency_hz is not None:
                value = float(frequency_hz)

                if not 1.0 <= value <= 20000.0:
                    raise ValueError(
                        "Frequency must be between 1 and 20000 Hz."
                    )

                self.frequency_hz = value

            if amplitude is not None:
                value = float(amplitude)

                if not 0.0 <= value <= 1.0:
                    raise ValueError(
                        "Amplitude must be between 0.0 and 1.0."
                    )

                self.amplitude = value

            if waveform is not None:
                value = str(waveform).lower()

                if value not in self.SUPPORTED_WAVEFORMS:
                    raise ValueError(
                        f"Unsupported waveform: {value}"
                    )

                self.waveform = value

            if attack_s is not None:
                self.attack_s = max(
                    0.0,
                    float(attack_s),
                )

            if hold_s is not None:
                self.hold_s = max(
                    0.0,
                    float(hold_s),
                )

            if release_s is not None:
                self.release_s = max(
                    0.0,
                    float(release_s),
                )

            if rest_s is not None:
                self.rest_s = max(
                    0.0,
                    float(rest_s),
                )

            if repeats is not None:
                self.repeats = max(
                    1,
                    int(repeats),
                )

            if device is not None:
                self.device = str(device)

            if channel is not None:
                value = str(channel).lower()

                if value not in {
                    "left",
                    "right",
                    "both",
                }:
                    raise ValueError(
                        "Channel must be left, right, or both."
                    )

                self.channel = value

            return self.status()

    def start(self):
        with self._lock:

            self._stop_locked()

            cmd = [
                "python3",
                str(self.driver_script),

                "--device",
                self.device,

                "--channel",
                self.channel,

                "--frequency",
                str(self.frequency_hz),

                "--amplitude",
                str(self.amplitude),

                "--attack",
                str(self.attack_s),

                "--hold",
                str(self.hold_s),

                "--release",
                str(self.release_s),
            ]

            print(
                "[PCM5122 AUDIO] START "
                f"channel={self.channel.upper()} "
                f"frequency={self.frequency_hz:.3f} "
                f"amplitude={self.amplitude:.6f}"
            )

            print(
                "[PCM5122 AUDIO] COMMAND "
                + " ".join(cmd)
            )

            if self.repeats > 1 or self.rest_s > 0:
                shell_parts = []

                for cycle in range(self.repeats):
                    shell_parts.append(
                        " ".join(
                            subprocess.list2cmdline([part])
                            for part in cmd
                        )
                    )

                    if (
                        cycle < self.repeats - 1
                        and self.rest_s > 0
                    ):
                        shell_parts.append(
                            f"sleep {self.rest_s}"
                        )

                shell_command = " && ".join(shell_parts)

                self._process = subprocess.Popen(
                    shell_command,
                    shell=True,
                )
            else:
                self._process = subprocess.Popen(
                    cmd
                )

            self.running = True

            return self.status()

    def stop(self):
        with self._lock:

            self._stop_locked()

            print(
                "[PCM5122 AUDIO] STOP "
                f"channel={self.channel.upper()}"
            )

            return self.status()

    def _stop_locked(self):

        process = self._process

        if process is not None:

            if process.poll() is None:

                process.terminate()

                try:
                    process.wait(
                        timeout=1.0
                    )

                except subprocess.TimeoutExpired:

                    process.kill()

                    process.wait()

        self._process = None
        self.running = False

    def status(self):

        if (
            self._process is not None
            and
            self._process.poll() is not None
        ):
            self.running = False
            self._process = None

        return {
            "running": self.running,
            "waveform": self.waveform,
            "frequency_hz": self.frequency_hz,
            "amplitude": self.amplitude,
            "attack_s": self.attack_s,
            "hold_s": self.hold_s,
            "release_s": self.release_s,
            "rest_s": self.rest_s,
            "repeats": self.repeats,
            "device": self.device,
            "channel": self.channel,
            "backend": "pi_pcm5122",
        }
